# Copier ce fichier en .env puis remplir les clés (ne jamais commiter .env)

# Fournisseur principal : gemini ou groq (l'autre sert de secours)
LLM_PROVIDER=gemini

# Google Gemini (offre gratuite) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (offre gratuite) : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Base de données : vide = SQLite local (data/interviewcoach.db).
# En production : l'adresse PostgreSQL de Neon, par ex. postgresql://user:motdepasse@hote/neondb?sslmode=require
DATABASE_URL=

# Adresse de l'API vue par l'interface Streamlit (inutile de la changer en local et dans Docker)
API_URL=http://127.0.0.1:8000
